# Dataset
# Athlete.xlsx is intentionally versioned: it is small and makes the
# preprocessing, training, and evaluation workflow reproducible.

# Train/test split caches (regenerate locally with preprocess.py; not needed by app.py)
models/X_train.npy
models/X_test.npy
models/y_train.pkl
models/y_test.pkl

# Large, reproducible experiment checkpoints.  Keep the evaluated final
# checkpoint below so the submitted application can run out of the box.
models/*.h5
models/*.keras
!models/best_model.keras

